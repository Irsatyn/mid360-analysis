<?xml version="1.0"?>
<package format="3">
  <name>mid360_analysis</name>
  <version>0.1.0</version>
  <description>MID360 and FAST-LIO IMU, odometry and TF analysis.</description>
  <maintainer email="simuel@users.noreply.github.com">simuel</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
